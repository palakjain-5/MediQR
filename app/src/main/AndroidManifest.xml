<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to talk to Supabase Auth / the database. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Saving the QR image into public Pictures on Android 9 and below.
         From Android 10 on, MediaStore needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediQR">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediQR"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Public medical card: the https URL the QR code encodes opens
                 this app straight into the no-login card screen. The host
                 comes from PUBLIC_CARD_BASE_URL in secrets.properties.
                 autoVerify lets the system open these links in the app once
                 the domain serves .well-known/assetlinks.json (hosted card
                 page); until then the system offers the browser/chooser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${publicCardHost}"
                    android:pathPrefix="/card/" />
            </intent-filter>
        </activity>

        <!-- Shares the generated QR PNG (from the app cache) with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>